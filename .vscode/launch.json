{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RobotCode: Run Current",
            "type": "robotcode",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "target": "${file}",
            "args": [
                "-dResults",
                "-V ./../Configuration/timeout-config-qa.yaml",
                "-V ./../Data/open-emr-pipeline.yaml"
            ]
        },
        {
            "name": "RobotCode: Run All",
            "type": "robotcode",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "target": ".",
            "args": [
                "-dResults",
                "-V ./../Configuration/timeout-config-qa.yaml",
                "-V ./../Data/open-emr-pipeline.yaml"
            ]
        },
        {
            "name": "RobotCode: Default",
            "type": "robotcode",
            "request": "launch",
            "purpose": "default",
            "presentation": {
                "hidden": true
            },
            "pythonConfiguration": "RobotCode: Python",
            "args": [
                "-dResults",
                "-V ./../Configuration/timeout-config-qa.yaml",
                "-V ./../Data/open-emr-pipeline.yaml"
            ]
        },
        {
            "name": "RobotCode: Python",
            "type": "debugpy",
            "request": "attach",
            "presentation": {
                "hidden": true
            }
        }
    ]
}